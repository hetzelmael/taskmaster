# === Variables d'environnement TaskMaster ===
# Copier ce fichier en .env et adapter les valeurs
# NE JAMAIS committer le fichier .env (il est dans .gitignore)

# --- Application ---
NODE_ENV=development
PORT=3000

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskmaster
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=changeme
DB_APP_USER=taskmaster_app
DB_APP_PASSWORD=app_secret

# --- Redis (cache/sessions) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# --- Authentification JWT ---
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_a_random_64_char_string
JWT_EXPIRES_IN=24h
